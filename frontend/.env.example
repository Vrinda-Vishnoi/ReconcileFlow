# Frontend Environment Variables
# Leave VITE_API_URL empty on Vercel if frontend/vercel.json rewrites /api to Render.
# Use a full URL only if you want direct browser calls to the backend.
VITE_API_URL=

# Set this on Vercel for Socket.IO because WebSockets should connect directly to Render.
VITE_SOCKET_URL=https://reconcileflow-backend.onrender.com
